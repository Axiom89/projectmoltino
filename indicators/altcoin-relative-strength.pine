//@version=6
indicator("Altcoin Relative Strength vs OTHERS", shorttitle="Alt RS", overlay=false, precision=2)

// ─── Inputs ───────────────────────────────────────────────────────────────────
othersSymbol = input.string("CRYPTOCAP:OTHERS", "OTHERS Market Cap Symbol", tooltip="Market cap excluding top 10 coins")
rsLength     = input.int(14, "RSI Length", minval=2)
maLength     = input.int(14, "Signal MA Length", minval=1)
maType       = input.string("SMA", "Signal MA Type", options=["SMA", "EMA"])
obLevel      = input.float(70, "Overbought Level", minval=50, maxval=100)
osLevel      = input.float(30, "Oversold Level", minval=0, maxval=50)

// ─── Colors ───────────────────────────────────────────────────────────────────
bullColor = input.color(#26a69a, "Bull Color")
bearColor = input.color(#ef5350, "Bear Color")
maColor   = input.color(#FF9800, "Signal MA Color")

// ─── Data ─────────────────────────────────────────────────────────────────────
othersClose = request.security(othersSymbol, timeframe.period, close)

// ─── Relative Strength RSI ────────────────────────────────────────────────────
// Ratio of altcoin to OTHERS mcap — then apply RSI to that ratio
// When the altcoin outperforms OTHERS, the ratio rises → RSI goes up
// When the altcoin underperforms OTHERS, the ratio falls → RSI goes down
ratio = close / othersClose
rsRsi = ta.rsi(ratio, rsLength)

// ─── Signal MA ────────────────────────────────────────────────────────────────
signalMa = maType == "EMA" ? ta.ema(rsRsi, maLength) : ta.sma(rsRsi, maLength)

// ─── Color Logic ──────────────────────────────────────────────────────────────
// RSI line color: green when above signal MA (outperforming), red when below
rsColor = rsRsi >= signalMa ? bullColor : bearColor

// Fill color between RSI and signal: green/red with transparency
fillColor = rsRsi >= signalMa ? color.new(bullColor, 85) : color.new(bearColor, 85)

// ─── Plotting ─────────────────────────────────────────────────────────────────
rsPlot = plot(rsRsi, "Alt RS", color=rsColor, linewidth=2)
maPlot = plot(signalMa, "Signal MA", color=maColor, linewidth=1)
fill(rsPlot, maPlot, color=fillColor)

// OB/OS levels
h1 = hline(obLevel, "Overbought", color=color.new(color.gray, 60), linestyle=hline.style_dashed)
hline(50, "Midline", color=color.new(color.gray, 80), linestyle=hline.style_dotted)
h2 = hline(osLevel, "Oversold", color=color.new(color.gray, 60), linestyle=hline.style_dashed)
fill(h1, h2, color=color.new(color.gray, 95), title="OB/OS Background")

// ─── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(ta.crossover(rsRsi, obLevel), "RS Overbought", "{{ticker}} Alt RS entered overbought vs OTHERS")
alertcondition(ta.crossunder(rsRsi, osLevel), "RS Oversold", "{{ticker}} Alt RS entered oversold vs OTHERS")
alertcondition(ta.crossover(rsRsi, signalMa), "RS Cross Above Signal", "{{ticker}} Alt RS crossed above signal MA")
alertcondition(ta.crossunder(rsRsi, signalMa), "RS Cross Below Signal", "{{ticker}} Alt RS crossed below signal MA")
alertcondition(ta.crossover(rsRsi, 50), "RS Cross Above 50", "{{ticker}} Alt RS crossed above midline")
alertcondition(ta.crossunder(rsRsi, 50), "RS Cross Below 50", "{{ticker}} Alt RS crossed below midline")
